{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "text": "${title}",
      "weight": "bolder",
      "size": "medium",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${content}",
      "wrap": true,
      "spacing": "medium"
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "时间:",
          "value": "${timestamp}"
        },
        {
          "title": "来源:",
          "value": "${source}"
        }
      ]
    }
  ]
}